# ============================================================
# .env.production.example
# Variables de entorno para producción en Render.com
#
# ⚠ NUNCA subas este archivo con valores reales al repositorio.
# Copia a .env.production y rellena los valores reales.
# En Render, configura estas variables en el Dashboard o
# mediante render.yaml (las que no son secretas).
# ============================================================

# ─── Backend ────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
API_PREFIX=/api/v1
LOG_LEVEL=info

# Base de datos — Render genera esto automáticamente
DATABASE_URL=postgresql://user:password@host:5432/trazabilidad?schema=public

# Redis — Render genera esto automáticamente
REDIS_URL=redis://:password@host:6379

# JWT — Genera con: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_SUPER_LONG_RANDOM_STRING_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_SUPER_LONG_RANDOM_STRING_64_CHARS
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS — URL pública del frontend (sin trailing slash)
CORS_ORIGIN=https://trazabilidad-frontend.onrender.com

# QR — URL base del portal público
QR_BASE_URL=https://trazabilidad-frontend.onrender.com/t

# Email (SendGrid recomendado)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.YOUR_SENDGRID_API_KEY
EMAIL_FROM=noreply@tudominio.com

# AWS S3 (opcional, para subir documentos)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=trazabilidad-docs

# ─── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://trazabilidad-backend.onrender.com/api/v1
NEXT_PUBLIC_APP_URL=https://trazabilidad-frontend.onrender.com
NEXT_PUBLIC_QR_BASE_URL=https://trazabilidad-frontend.onrender.com/t
NEXT_PUBLIC_APP_NAME=Sistema de Trazabilidad Alimentaria
