# ==========================================
# CONFIGURACIÓN GENERAL
# ==========================================
NODE_ENV=development

# ==========================================
# BASE DE DATOS
# ==========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/trazabilidad?schema=public"

# ==========================================
# BACKEND
# ==========================================
PORT=3001
API_PREFIX=/api/v1

# JWT
JWT_SECRET="jwt-secret-super-seguro-cambiar-en-produccion"
JWT_REFRESH_SECRET="jwt-refresh-secret-super-seguro-cambiar-en-produccion"
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGIN="http://localhost:3000"

# Email (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
EMAIL_FROM=noreply@trazabilidad-panaderia.com

# AWS S3 (Almacenamiento)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=trazabilidad-docs

# Redis
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Código QR
QR_BASE_URL=https://trazabilidad-panaderia.com/t

# Logging
LOG_LEVEL=debug
LOG_DIR=logs

# Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# ==========================================
# FRONTEND
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_QR_BASE_URL=http://localhost:3000/t
NEXT_PUBLIC_APP_NAME=Sistema de Trazabilidad Alimentaria
NEXT_PUBLIC_APP_URL=http://localhost:3000