NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/trazabilidad?schema=public"

JWT_SECRET="generar-uuid-seguro-aqui"
JWT_REFRESH_SECRET="generar-otro-uuid-seguro-aqui"
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

CORS_ORIGIN="http://localhost:3000"

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-api-key
EMAIL_FROM=noreply@midominio.com

AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=my-bucket

REDIS_URL=redis://localhost:6379

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

QR_BASE_URL=https://trazabilidad.midominio.com/t

LOG_LEVEL=debug
LOG_DIR=logs

MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads